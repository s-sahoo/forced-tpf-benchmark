# Copy this file to <runtime-root>/assets.env and fill in paths or Hugging Face
# model IDs. scripts/install.sh writes the Python runtime settings separately.

# Qwen3 assets for Figures 1 and 3.
export QWEN_BASE_MODEL=/path/to/Qwen3-8B
# Used by Nano Uno (Figures 1-3).
export QWEN_UNO_LORA=/path/to/Qwen3-8B-Uno-LoRA
export EAGLE3_DRAFT_MODEL=/path/to/Qwen3-8B-EAGLE3-draft
export DFLASH_DRAFT_MODEL=/path/to/Qwen3-8B-DFlash-draft

# BBQ assets for Figure 4.
export BBQ_BASE_MODEL=/path/to/BBQ-8B
export BBQ_GATED_LORA=/path/to/BBQ-8B-gated-LoRA
export NEMOTRON_MODEL=/path/to/Nemotron-Diffusion-14B
export NEMOTRON_LORA_PATH=/path/to/Nemotron-linear-spec-LoRA
export DIFFGEMMA_MODEL=/path/to/DiffusionGemma-26B-A4B

# Optional Hugging Face settings. Set offline mode only after every asset is
# present locally.
export HF_HOME=/path/to/huggingface-cache
export HF_HUB_OFFLINE=0
